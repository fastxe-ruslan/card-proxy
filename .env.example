NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=card-proxy
DB_SCHEMA=card_proxy

JWT_ACCESS_SECRET=c04026893cdc9dfe476485d1df176e4b
JWT_REFRESH_SECRET=a494a509c1aee4c237b90149102f3953
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

WASABI_API_BASE_URL=https://sandbox.wasabi.example
WASABI_API_KEY=change-me
WASABI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nchange-me\n-----END PRIVATE KEY-----"

# Public URL of this service — used in email verification links
APP_URL=http://localhost:3000/api/v1

# Wasabi RSA public key for X-WSB-SIGNATURE; omit only in dev or with SKIP_WEBHOOK_SIGNATURE_VERIFICATION=true
WASABI_WEBHOOK_PUBLIC_KEY=
WASABI_TIMEOUT_MS=10000
WASABI_MAX_RETRIES=3
SKIP_WEBHOOK_SIGNATURE_VERIFICATION=false

# Google OAuth — required for audience validation of Google idToken
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# Apple OAuth — bundle ID / service ID used as audience in Apple identityToken
APPLE_APP_ID=change-me.com.example.proxy-card
